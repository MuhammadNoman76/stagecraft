<UserControl x:Class="Stagecraft.Views.StartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Stagecraft.Controls"
             Focusable="False">
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel x:Name="Root" Margin="56,30,56,48" MaxWidth="1300">
            <!-- header -->
            <DockPanel Margin="0,0,0,26">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource IconButton}" c:Ui.Icon="{StaticResource Icon.Info}" ToolTip="About Stagecraft"
                            AutomationProperties.Name="About Stagecraft" Click="OnAbout" />
                    <Button Margin="4,0,0,0" Style="{StaticResource IconButton}" c:Ui.Icon="{StaticResource Icon.Settings}" ToolTip="Settings (Ctrl+,)"
                            AutomationProperties.Name="Settings" Click="OnSettings" />
                </StackPanel>
                <Image DockPanel.Dock="Left" Width="52" Height="52" Margin="0,0,16,0" Source="{StaticResource Logo.Mark}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Text.Title}" Text="Stagecraft" FontSize="30" />
                    <TextBlock Style="{StaticResource Text.BodySecondary}" Margin="1,2,0,0" Text="Presentations that look designed. Without the effort." />
                </StackPanel>
            </DockPanel>

            <!-- recovered work -->
            <StackPanel x:Name="RecoveryPanel" Visibility="Collapsed" Margin="0,0,0,24" />

            <!-- new -->
            <DockPanel Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource IconTextButton}" c:Ui.Icon="{StaticResource Icon.FolderOpen}" Content="Open…" Click="OnOpen"
                            ToolTip="Open a presentation (Ctrl+O)" />
                    <Button Margin="8,0,0,0" Style="{StaticResource IconTextButton}" c:Ui.Icon="{StaticResource Icon.ArrowImport}" Content="Import PowerPoint…"
                            Click="OnImport" ToolTip="Import a .pptx file" />
                </StackPanel>
                <TextBlock Style="{StaticResource Text.Subtitle}" Text="Start with a theme" VerticalAlignment="Center" />
            </DockPanel>
            <ItemsControl x:Name="ThemeCards" Focusable="False" Margin="-8,0,-8,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <c:CardGrid MinItemWidth="232" Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- samples -->
            <TextBlock Style="{StaticResource Text.Subtitle}" Text="Explore a sample" Margin="0,30,0,12" />
            <ItemsControl x:Name="SampleCards" Focusable="False" Margin="-8,0,-8,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <c:CardGrid MinItemWidth="232" Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- recent -->
            <TextBlock Style="{StaticResource Text.Subtitle}" Text="Recent" Margin="0,30,0,12" />
            <TextBlock x:Name="NoRecent" Style="{StaticResource Text.BodySecondary}" Visibility="Collapsed"
                       Text="Presentations you open or save appear here." />
            <ItemsControl x:Name="RecentCards" Focusable="False" Margin="-8,0,-8,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <c:CardGrid MinItemWidth="232" Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
