<UserControl x:Class="Stagecraft.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Stagecraft.Controls"
             xmlns:e="clr-namespace:Stagecraft.Views.Editor"
             Focusable="False">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================ command bar -->
        <Grid x:Name="CommandBar" Height="52" Margin="10,2,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- file menu + title -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="MenuButton" Style="{StaticResource SubtleButton}" Padding="6,4" ToolTip="Menu (Alt+F)"
                        AutomationProperties.Name="Menu" Click="OnMenu">
                    <StackPanel Orientation="Horizontal">
                        <Image Width="22" Height="22" Source="{StaticResource Logo.Mark}" />
                        <c:IconView Width="10" Height="10" Margin="6,1,0,0" Data="{StaticResource Icon.ChevronDown}" Foreground="{DynamicResource Text.Secondary}" />
                    </StackPanel>
                </Button>
                <StackPanel Margin="6,0,0,0" VerticalAlignment="Center" MaxWidth="260">
                    <TextBox x:Name="TitleBox" Style="{StaticResource TitleBox}"
                             AutomationProperties.Name="Presentation title" ToolTip="Presentation title" />
                    <TextBlock x:Name="SaveState" Margin="7,-1,0,0" FontSize="11" Foreground="{DynamicResource Text.Tertiary}" />
                </StackPanel>
            </StackPanel>

            <!-- undo / redo -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                <Button x:Name="UndoButton" Style="{StaticResource IconButton}" c:Ui.Icon="{StaticResource Icon.ArrowUndo}" ToolTip="Undo (Ctrl+Z)"
                        AutomationProperties.Name="Undo" Click="OnUndo" />
                <Button x:Name="RedoButton" Style="{StaticResource IconButton}" c:Ui.Icon="{StaticResource Icon.ArrowRedo}" ToolTip="Redo (Ctrl+Y)"
                        AutomationProperties.Name="Redo" Click="OnRedo" />
                <Border Width="1" Height="22" Margin="10,0,6,0" Background="{DynamicResource Divider}" />
            </StackPanel>

            <!-- insert -->
            <StackPanel x:Name="InsertBar" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="NewSlideButton" Style="{StaticResource CommandButton}" c:Ui.Icon="{StaticResource Icon.SlideAdd}" Content="New slide"
                        ToolTip="New slide (Ctrl+M) – right-click to pick a layout" AutomationProperties.Name="New slide" Click="OnNewSlide" />
                <Button x:Name="LayoutDrop" Style="{StaticResource IconButton}" Width="22" Margin="-6,0,4,0" c:Ui.Icon="{StaticResource Icon.ChevronDown}"
                        ToolTip="New slide with a layout" AutomationProperties.Name="New slide with a layout" Click="OnNewSlideMenu" />
                <Button Style="{StaticResource CommandButton}" c:Ui.Icon="{StaticResource Icon.TextT}" Content="Text" ToolTip="Text box (T)"
                        AutomationProperties.Name="Insert text box" Click="OnInsertText" />
                <Button x:Name="ShapeButton" Style="{StaticResource CommandButton}" c:Ui.Icon="{StaticResource Icon.Shapes}" Content="Shape" ToolTip="Shapes, lines and arrows"
                        AutomationProperties.Name="Insert shape" Click="OnInsertShapeMenu" />
                <Button Style="{StaticResource CommandButton}" c:Ui.Icon="{StaticResource Icon.ImageAdd}" Content="Image" ToolTip="Picture from a file (or paste / drop one)"
                        AutomationProperties.Name="Insert image" Click="OnInsertImage" />
                <Button x:Name="MediaButton" Style="{StaticResource CommandButton}" c:Ui.Icon="{StaticResource Icon.VideoClip}" Content="Media" ToolTip="Video, sound or an online video"
                        AutomationProperties.Name="Insert video or sound" Click="OnInsertMediaMenu" />
                <Button Style="{StaticResource CommandButton}" c:Ui.Icon="{StaticResource Icon.Icons}" Content="Icon" ToolTip="Icon (searchable)"
                        AutomationProperties.Name="Insert icon" Click="OnInsertIcon" />
                <Button Style="{StaticResource CommandButton}" c:Ui.Icon="{StaticResource Icon.DataBarVertical}" Content="Chart" ToolTip="Chart"
                        AutomationProperties.Name="Insert chart" Click="OnInsertChart" />
                <Button Style="{StaticResource CommandButton}" c:Ui.Icon="{StaticResource Icon.Table}" Content="Table" ToolTip="Table"
                        AutomationProperties.Name="Insert table" Click="OnInsertTable" />
                <Button Style="{StaticResource CommandButton}" c:Ui.Icon="{StaticResource Icon.Link}" Content="Link" ToolTip="Link to a web page, e-mail, slide or file (Ctrl+Shift+K)"
                        AutomationProperties.Name="Insert link" Click="OnInsertLink" />
            </StackPanel>

            <!-- right side -->
            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource SegmentTray}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ViewEditor" Style="{StaticResource IconSegment}" c:Ui.Icon="{StaticResource Icon.SlideText}" IsChecked="True"
                                     ToolTip="Editor (Ctrl+1)" AutomationProperties.Name="Editor view" GroupName="View" Checked="OnViewChanged" />
                        <RadioButton x:Name="ViewSorter" Style="{StaticResource IconSegment}" c:Ui.Icon="{StaticResource Icon.Grid}"
                                     ToolTip="Slide sorter (Ctrl+2)" AutomationProperties.Name="Slide sorter view" GroupName="View" Checked="OnViewChanged" />
                        <RadioButton x:Name="ViewOutline" Style="{StaticResource IconSegment}" c:Ui.Icon="{StaticResource Icon.TextBulletListSquare}"
                                     ToolTip="Outline (Ctrl+3)" AutomationProperties.Name="Outline view" GroupName="View" Checked="OnViewChanged" />
                    </StackPanel>
                </Border>
                <Button x:Name="PaletteButton" Style="{StaticResource PaletteButton}" Width="236" Margin="0,0,8,0" Content="Search commands"
                        AutomationProperties.Name="Command palette" ToolTip="Find any command, layout, theme or slide (Ctrl+K)" Click="OnPalette" />
                <ToggleButton x:Name="AnimationsToggle" Style="{StaticResource SubtleToggle}" c:Ui.Icon="{StaticResource Icon.StarEmphasis}" Content="Animations"
                              ToolTip="Animations on this slide: add, order and time them" AutomationProperties.Name="Animations" Margin="0,0,4,0" Click="OnAnimationsToggle" />
                <ToggleButton x:Name="DesignToggle" Style="{StaticResource SubtleToggle}" c:Ui.Icon="{StaticResource Icon.Color}" Content="Design"
                              ToolTip="Themes, colours and slide size" AutomationProperties.Name="Design" Margin="0,0,6,0" Click="OnDesign" />
                <Button x:Name="PresentButton" Style="{StaticResource AccentCommandButton}" c:Ui.Icon="{StaticResource Icon.PlayFilled}" Content="Present"
                        ToolTip="Present from the start (F5) – Shift+F5 from this slide" AutomationProperties.Name="Present" Click="OnPresent" />
                <Button x:Name="PresentMenuButton" Style="{StaticResource AccentButton}" Width="30" MinWidth="30" Height="32" Padding="0" Margin="1,0,0,0"
                        ToolTip="More ways to present" AutomationProperties.Name="More ways to present" Click="OnPresentMenu">
                    <c:IconView Width="12" Height="12" Data="{StaticResource Icon.ChevronDown}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============================================================ work area -->
        <Grid x:Name="WorkArea" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="RailColumn" Width="236" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="PanelColumn" Width="312" />
            </Grid.ColumnDefinitions>

            <!-- slide rail -->
            <e:SlideRail x:Name="Rail" Grid.Column="0" />

            <!-- canvas + notes, inside a rounded "content layer" like Windows 11 apps -->
            <Border x:Name="CenterLayer" Grid.Column="1" CornerRadius="8,8,0,0" BorderThickness="1,1,1,0" Margin="0,0,0,0"
                    Background="{DynamicResource Canvas.Background}" BorderBrush="{DynamicResource Layer.Stroke}" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition x:Name="NotesRow" Height="132" />
                    </Grid.RowDefinitions>
                    <e:SlideCanvas x:Name="Canvas" />
                    <!-- zoom controls -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,12" CornerRadius="8" Padding="2"
                            Background="{DynamicResource Flyout.Background}" BorderBrush="{DynamicResource Flyout.Stroke}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ViewAidsButton" Style="{StaticResource IconButton}" Width="28" Height="28" c:Ui.Icon="{StaticResource Icon.Ruler}" ToolTip="Rulers, gridlines and guides"
                                    AutomationProperties.Name="Rulers, gridlines and guides" Click="OnViewAidsMenu" />
                            <Border Width="1" Margin="2,6" Background="{DynamicResource Divider}" />
                            <Button Style="{StaticResource IconButton}" Width="28" Height="28" c:Ui.Icon="{StaticResource Icon.ZoomOut}" ToolTip="Zoom out (Ctrl+-)"
                                    AutomationProperties.Name="Zoom out" Click="OnZoomOut" />
                            <Button x:Name="ZoomText" Style="{StaticResource SubtleButton}" MinWidth="52" Height="28" Padding="4,0" FontSize="12" ToolTip="Fit to window (Ctrl+0)"
                                    AutomationProperties.Name="Zoom level, click to fit" Click="OnZoomFit" />
                            <Button Style="{StaticResource IconButton}" Width="28" Height="28" c:Ui.Icon="{StaticResource Icon.ZoomIn}" ToolTip="Zoom in (Ctrl++)"
                                    AutomationProperties.Name="Zoom in" Click="OnZoomIn" />
                        </StackPanel>
                    </Border>
                    <!-- find and replace -->
                    <e:FindBar x:Name="FindPanel" />
                    <!-- slide position -->
                    <TextBlock x:Name="SlidePosition" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16,0,0,16" FontSize="12"
                               Foreground="{DynamicResource Text.Tertiary}" IsHitTestVisible="False" />

                    <GridSplitter x:Name="NotesSplitter" Grid.Row="1" Height="6" HorizontalAlignment="Stretch" ResizeDirection="Rows" Background="Transparent"
                                  Focusable="False" ResizeBehavior="PreviousAndNext" DragCompleted="OnNotesResized" />
                    <Border x:Name="NotesPane" Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Divider}" Background="{DynamicResource Layer.Background}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="16,8,8,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="26" Height="26" c:Ui.Icon="{StaticResource Icon.ChevronDown}"
                                        ToolTip="Hide notes" AutomationProperties.Name="Hide speaker notes" Click="OnToggleNotes" />
                                <TextBlock Style="{StaticResource PanelHeader}" Margin="0" Text="Speaker notes" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBox x:Name="NotesBox" Margin="10,2,10,8" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" MinHeight="0"
                                     c:Ui.Placeholder="Click to add notes for this slide. Only you see them while presenting."
                                     AutomationProperties.Name="Speaker notes" />
                        </DockPanel>
                    </Border>
                    <Button x:Name="ShowNotesButton" Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,8"
                            Style="{StaticResource CommandButton}" Height="28" c:Ui.Icon="{StaticResource Icon.Note}" Content="Notes" Visibility="Collapsed"
                            ToolTip="Show speaker notes" AutomationProperties.Name="Show speaker notes" Click="OnToggleNotes" />
                </Grid>
            </Border>

            <!-- properties -->
            <e:PropertiesPanel x:Name="Panel" Grid.Column="2" />

            <!-- sorter and outline replace the rail and the canvas -->
            <ContentControl x:Name="AltView" Grid.Column="0" Grid.ColumnSpan="2" Visibility="Collapsed" Focusable="False" />
        </Grid>

        <!-- command palette and other overlays -->
        <Grid x:Name="OverlayLayer" Grid.RowSpan="2" />
    </Grid>
</UserControl>
