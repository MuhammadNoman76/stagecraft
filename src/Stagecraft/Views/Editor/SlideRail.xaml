<UserControl x:Class="Stagecraft.Views.Editor.SlideRail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Stagecraft.Controls"
             xmlns:e="clr-namespace:Stagecraft.Views.Editor"
             Focusable="False">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <DataTemplate x:Key="RailTemplate" DataType="{x:Type e:RailItem}">
            <StackPanel>
                <DockPanel Margin="26,6,0,6" Visibility="{Binding HasSection, Converter={StaticResource Visible}}">
                    <Border Width="3" Height="12" CornerRadius="1.5" Background="{DynamicResource Accent.Fill}" Margin="0,0,7,0" />
                    <TextBlock Text="{Binding Section}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Width="26" Margin="0,2,4,0">
                        <TextBlock Text="{Binding Number}" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource Rail.Number}" />
                        <c:IconView Width="12" Height="12" Margin="0,6,0,0" HorizontalAlignment="Right" Data="{StaticResource Icon.EyeOff}"
                                    Foreground="{DynamicResource Text.Tertiary}" Visibility="{Binding Hidden, Converter={StaticResource Visible}}" />
                    </StackPanel>
                    <Grid Height="{Binding ThumbHeight}">
                        <Border x:Name="Frame" CornerRadius="7" BorderThickness="2" BorderBrush="Transparent" Margin="-3" />
                        <Border CornerRadius="5" Background="{DynamicResource Card.Background}" BorderThickness="1" BorderBrush="{DynamicResource Thumb.Stroke}" />
                        <Border x:Name="Picture" CornerRadius="5" Margin="1">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Grid>
                </DockPanel>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent.Fill}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent.Fill}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Hidden}" Value="True">
                    <Setter TargetName="Picture" Property="Opacity" Value="0.4" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="18,6,10,4">
            <TextBlock x:Name="CountText" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Text.Tertiary}" VerticalAlignment="Center" />
            <TextBlock Style="{StaticResource PanelHeader}" Margin="0" Text="Slides" VerticalAlignment="Center" />
        </DockPanel>
        <Button x:Name="AddButton" DockPanel.Dock="Bottom" Margin="12,6,12,12" HorizontalAlignment="Stretch" Style="{StaticResource IconTextButton}"
                c:Ui.Icon="{StaticResource Icon.Add}" Content="New slide" AutomationProperties.Name="New slide" ToolTip="New slide (Ctrl+M)" />
        <Grid>
            <ListBox x:Name="List" Background="Transparent" BorderThickness="0" Padding="4,2,6,8" SelectionMode="Extended"
                     ItemContainerStyle="{StaticResource RailItem}" ItemTemplate="{StaticResource RailTemplate}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                     AllowDrop="True" AutomationProperties.Name="Slides" />
            <Canvas x:Name="DropLayer" IsHitTestVisible="False">
                <Border x:Name="DropLine" Height="3" CornerRadius="1.5" Background="{DynamicResource Accent.Fill}" Visibility="Collapsed" />
            </Canvas>
        </Grid>
    </DockPanel>
</UserControl>
