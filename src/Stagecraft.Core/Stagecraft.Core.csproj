<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Stagecraft's engine: the deck model and its .stagecraft file format, themes and smart layouts, the slide
    renderer (WPF drawing), snapping / tidy / morph maths, and the PDF, image and PowerPoint import / export.
    No windows here, so the tests use it directly. Same two targets as the app.
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net48</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Stagecraft.Core</RootNamespace>
    <AssemblyName>Stagecraft.Core</AssemblyName>
    <Version>1.0.0</Version>
    <Product>Stagecraft</Product>
    <Company>Stagecraft</Company>
    <Copyright>Copyright © 2026 Muhammad Noman</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Net.Http" />
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <!-- MIT licence: .pptx import and export -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <!-- MIT licence: PDF export -->
    <PackageReference Include="PDFsharp" Version="6.2.4" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="System.Text.Json" Version="10.0.12" />
    <Reference Include="System.IO.Compression" />
  </ItemGroup>

  <ItemGroup>
    <!-- The bundled SIL OFL fonts, loaded privately from <app>\Fonts (never installed). tools\get-fonts.ps1 refreshes them. -->
    <None Include="Fonts\*.ttf;Fonts\*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- The icons people can place on slides (generated by tools\make-icons.mjs). -->
    <EmbeddedResource Include="Assets\IconCatalog.txt" LogicalName="Stagecraft.IconCatalog.txt" />
  </ItemGroup>

</Project>
